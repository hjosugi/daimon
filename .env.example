# Copy this file to .env and keep the real values local. `.env` is ignored.
# Export it before starting the API:
#   set -a; source .env; set +a

# For hosted Supabase, prefer the session pooler so Cloud Run can use IPv4.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require

QDRANT_URL=https://<cluster>.cloud.qdrant.io:6333
QDRANT_API_KEY=<qdrant-api-key>
EMBED_URL=http://localhost:8001
REDIS_URL=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PORT=8000
