{
  "$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "css": {
        "nursery": {
          "noUnknownAtRules": {
            "level": "warn",
            "options": {
              "ignore": ["theme", "apply", "config", "tailwind", "custom-variant", "utility", "source"]
            }
          }
        }
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
