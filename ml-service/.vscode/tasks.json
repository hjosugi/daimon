{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ML: uv sync",
      "type": "shell",
      "command": "uv sync --locked",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "ML: dev server",
      "type": "shell",
      "command": "uv run uvicorn app:app --host 0.0.0.0 --port 8001 --reload",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "ML: smoke POV",
      "type": "shell",
      "command": "uv run python - <<'PY'\nfrom app import TextReq, povs\nprint(povs(TextReq(text='テンポは遅いが余韻が強い')))\nPY",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "ML: smoke embed",
      "type": "shell",
      "command": "uv run python - <<'PY'\nfrom app import encode_full\nvec = encode_full('余韻のある作品だった')\nprint(len(vec), type(vec[0]).__name__)\nPY",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
