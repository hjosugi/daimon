{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ML: Debug uvicorn",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app:app", "--host", "0.0.0.0", "--port", "8001", "--reload"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "env": {
        "PORT": "8001"
      },
      "preLaunchTask": "ML: uv sync"
    }
  ]
}
